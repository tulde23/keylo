{
  // Cloudflare Workers "static assets" config for the keylo.dev marketing site.
  //
  // The Cloudflare build runs `npx wrangler deploy`, which uploads the folder in
  // `assets.directory` as the site — no Worker script, no build step. Without this
  // file, Cloudflare auto-detected the Tauri app in app/ and served its source tree.
  //
  // IMPORTANT: the Cloudflare project's build "Root directory" must be the repo root
  // (blank), not `app`, so `wrangler deploy` reads this file and serves ./site.
  "name": "keylo",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site"
  },
  // Keep the *.workers.dev preview URL available; the custom domain keylo.dev is
  // attached in the Cloudflare dashboard (Workers > keylo > Domains & Routes).
  "workers_dev": true
}
