<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    keylo-mac stores Keylo's Touch ID vault-unlock key in the data-protection keychain, behind a
    biometric access control. That keychain needs a keychain-access-group entitlement tied to the
    signing team (Admonis LLC, 8R4JRSZ8KB); without it SecItemAdd returns errSecMissingEntitlement.
    Only keylo-mac uses this item, so only keylo-mac carries the entitlement.
  -->
  <key>keychain-access-groups</key>
  <array>
    <string>8R4JRSZ8KB.io.github.tulde23.keylo</string>
  </array>
</dict>
</plist>
