{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keylo",
  "identifier": "io.github.tulde23.keylo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAzQzVCRDZFRUVGMkJCNDEKUldSQnUvTHVicjNGQTYxTmNlRk4wOVd5NHMyaW03ZWNFV25kbVZNdWZoT2I4UEF3RVJqYnVXTWsK",
      "endpoints": [
        "https://github.com/tulde23/keylo/releases/latest/download/latest.json"
      ]
    }
  }
}
