<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:vm="using:Keylo.App.ViewModels"
             xmlns:views="using:Keylo.Desktop.Views"
             x:Class="Keylo.Desktop.Views.SecretDetailView"
             x:DataType="vm:SecretDetailViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
        <StackPanel MaxWidth="720">

            <!-- ======================================================== view mode -->
            <StackPanel IsVisible="{Binding IsViewing}">
                <DockPanel Margin="0,0,0,24">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Spacing="4">
                        <Button Classes="subtle" Command="{Binding TogglePinCommand}" ToolTip.Tip="{Binding IsPinned, Converter={x:Static views:Convert.PinMenuText}}">
                            <Panel>
                                <ic:SymbolIcon Symbol="Pin" FontSize="18" IsVisible="{Binding !IsPinned}" />
                                <ic:SymbolIcon Symbol="PinOff" FontSize="18" IsVisible="{Binding IsPinned}" />
                            </Panel>
                        </Button>
                        <Button Command="{Binding EditCommand}" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:SymbolIcon Symbol="Edit" FontSize="16" />
                                <TextBlock Text="Edit" />
                            </StackPanel>
                        </Button>
                        <Button Classes="subtle" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete">
                            <ic:SymbolIcon Symbol="Delete" FontSize="18" />
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <views:IconTile Width="56" Height="56" CornerRadius="16" GlyphSize="28"
                                        Fill="{Binding TileBrush}" Image="{Binding Image}" Symbol="{Binding Symbol}" />
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Spacing="6">
                                <Border Classes="chip" IsVisible="{Binding IsTyped}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <ic:SymbolIcon Symbol="{Binding SelectedType.Symbol}" FontSize="13" Foreground="{DynamicResource AccentText}" />
                                        <TextBlock Text="{Binding TypeName}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="chip" IsVisible="{Binding HasCategory}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <ic:SymbolIcon Symbol="Folder" FontSize="13" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Text="{Binding Category}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <!-- Link banner -->
                <Border Classes="surface" Padding="14,10" Margin="0,0,0,12" IsVisible="{Binding IsLinked}">
                    <DockPanel>
                        <ic:SymbolIcon Symbol="Link" FontSize="18" Foreground="{DynamicResource AccentText}" VerticalAlignment="Top" />
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="{Binding LinkDescription}" TextWrapping="Wrap" />
                            <TextBlock Text="Read live each time it's used — never stored in Keylo. The vault may ask you to unlock it." FontSize="12"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextTertiary}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Typed fields -->
                <StackPanel IsVisible="{Binding IsTyped}" Margin="0,0,0,4">
                    <DockPanel Margin="2,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                            <Button Classes="subtle" Command="{Binding ToggleValueCommand}" ToolTip.Tip="Show / hide secret fields (hides itself after 30s)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Panel>
                                        <ic:SymbolIcon Symbol="Eye" FontSize="16" IsVisible="{Binding !IsValueVisible}" />
                                        <ic:SymbolIcon Symbol="EyeOff" FontSize="16" IsVisible="{Binding IsValueVisible}" />
                                    </Panel>
                                    <Panel>
                                        <TextBlock Text="Show" IsVisible="{Binding !IsValueVisible}" />
                                        <TextBlock Text="Hide" IsVisible="{Binding IsValueVisible}" />
                                    </Panel>
                                </StackPanel>
                            </Button>
                            <Button Classes="accent" Command="{Binding CopyValueCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:SymbolIcon Symbol="Copy" FontSize="16" />
                                    <TextBlock Text="Copy main value" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="FIELDS" Classes="section" VerticalAlignment="Center" Margin="0" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Fields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FieldViewModel">
                                <Border Classes="surface" Margin="0,0,0,8" Padding="16,10" IsVisible="{Binding ShowInView}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Classes="subtle" VerticalAlignment="Center" ToolTip.Tip="Copy"
                                                Command="{Binding CopyCommand}" Margin="12,0,0,0">
                                            <ic:SymbolIcon Symbol="Copy" FontSize="18" />
                                        </Button>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SectionLabel}" Classes="section" Margin="0,0,0,2" />
                                                <TextBlock Text="  · built from the fields above" FontSize="11" Foreground="{DynamicResource TextTertiary}"
                                                           IsVisible="{Binding IsDerived}" />
                                            </StackPanel>
                                            <TextBox Classes="value" Classes.mono="{Binding IsSecret}" Text="{Binding DisplayValue, Mode=OneWay}"
                                                     MaxHeight="200" FontSize="14" Foreground="{DynamicResource TextPrimary}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Value (plain secrets) -->
                <Border Classes="surface" Margin="0,0,0,12" IsVisible="{Binding IsPlain}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" Spacing="6">
                            <Button Classes="subtle" Command="{Binding ToggleValueCommand}" ToolTip.Tip="Show / hide (hides itself after 30s)">
                                <Panel>
                                    <ic:SymbolIcon Symbol="Eye" FontSize="18" IsVisible="{Binding !IsValueVisible}" />
                                    <ic:SymbolIcon Symbol="EyeOff" FontSize="18" IsVisible="{Binding IsValueVisible}" />
                                </Panel>
                            </Button>
                            <Button Classes="accent" Command="{Binding CopyValueCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:SymbolIcon Symbol="Copy" FontSize="16" />
                                    <TextBlock Text="Copy" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="VALUE" Classes="section" />
                            <TextBox Classes="value mono" Text="{Binding MaskedValue, Mode=OneWay}" FontSize="15" MaxHeight="220"
                                     Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Key (stored as the credential's username) -->
                <Border Classes="surface" Margin="0,0,0,12" IsVisible="{Binding ShowKey}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Classes="subtle" ToolTip.Tip="Copy key" Command="{Binding CopyUsernameCommand}" VerticalAlignment="Center">
                            <ic:SymbolIcon Symbol="Copy" FontSize="18" />
                        </Button>
                        <StackPanel>
                            <TextBlock Text="KEY" Classes="section" />
                            <TextBlock Text="{Binding Username}" FontSize="15" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Notes -->
                <Border Classes="surface" Margin="0,0,0,12" IsVisible="{Binding HasNotes}">
                    <StackPanel>
                        <TextBlock Text="NOTES" Classes="section" />
                        <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                </Border>

                <!-- Details -->
                <Border Classes="surface" Margin="0,0,0,12">
                    <Grid ColumnDefinitions="*,*,1.4*">
                        <StackPanel>
                            <TextBlock Text="UPDATED" Classes="section" />
                            <TextBlock Text="{Binding UpdatedText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="SIZE" Classes="section" />
                            <TextBlock Text="{Binding SizeText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="STORED IN" Classes="section" />
                            <TextBlock Text="{Binding StorageText}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Push to other vaults + export -->
                <TextBlock Text="SHARE" Classes="section" Margin="2,12,0,8" />
                <WrapPanel>
                    <ItemsControl ItemsSource="{Binding Providers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProviderItem">
                                <Button Margin="0,0,8,8" IsEnabled="{Binding IsConfigured}" ToolTip.Tip="{Binding ToolTip}" ToolTip.ShowOnDisabled="True"
                                        Command="{Binding $parent[ItemsControl].((vm:SecretDetailViewModel)DataContext).PushToCommand}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ic:SymbolIcon Symbol="CloudArrowUp" FontSize="16" />
                                        <TextBlock Text="{Binding PushLabel}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Command="{Binding ExportCommand}" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon Symbol="ArrowExportUp" FontSize="16" />
                            <TextBlock Text="Export to file…" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>

            <!-- ======================================================== edit / new -->
            <StackPanel IsVisible="{Binding IsEditing}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                    <views:IconTile Width="44" Height="44" CornerRadius="12" GlyphSize="22"
                                    Fill="{Binding TileBrush}" Image="{Binding Image}" Symbol="{Binding Symbol}" />
                    <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel IsVisible="{Binding IsNotLinked}">
                    <TextBlock Text="Type" Classes="field" />
                    <ComboBox ItemsSource="{Binding TypeChoices}" SelectedItem="{Binding SelectedType}" Margin="0,0,0,16" MinWidth="260">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TypeChoice">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <ic:SymbolIcon Symbol="{Binding Symbol}" FontSize="16" Foreground="{DynamicResource AccentText}" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <Grid ColumnDefinitions="*,16,*" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Name" Classes="field" />
                        <TextBox Text="{Binding Name}" Watermark="e.g. cloudflare-token" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Category" Classes="field" />
                        <ComboBox IsEditable="True" HorizontalAlignment="Stretch" ItemsSource="{Binding Categories}" Text="{Binding Category}" />
                    </StackPanel>
                </Grid>

                <!-- Typed: one editor per field -->
                <ItemsControl ItemsSource="{Binding Fields}" IsVisible="{Binding ShowFieldEditors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FieldViewModel">
                            <StackPanel Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Label}" Classes="field" />
                                    <ic:SymbolIcon Symbol="LockClosed" FontSize="12" Margin="6,0,0,4" ToolTip.Tip="Secret: encrypted, masked, redacted from agent output"
                                                   Foreground="{DynamicResource TextTertiary}" IsVisible="{Binding IsSecret}" />
                                </StackPanel>
                                <ComboBox IsEditable="True" HorizontalAlignment="Stretch" ItemsSource="{Binding Options}" Text="{Binding Value}"
                                          IsVisible="{Binding HasOptions}" />
                                <TextBox Text="{Binding Value}" Watermark="{Binding Placeholder}" IsVisible="{Binding !HasOptions}"
                                         Classes.mono="{Binding IsSecret}" AcceptsReturn="{Binding IsMultiline}" TextWrapping="Wrap" MaxHeight="220"
                                         MinHeight="{Binding IsMultiline, Converter={x:Static views:Convert.MultilineHeight}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Plain: key and value -->
                <StackPanel IsVisible="{Binding IsPlain}">
                    <TextBlock Text="Key (optional)" Classes="field" />
                    <TextBox Text="{Binding Username}" Watermark="Key id, account or email" Margin="0,0,0,16" />

                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource TextTertiary}"
                                   Text="{Binding ValueLength, StringFormat='{}{0} characters'}" />
                        <TextBlock Text="Value" Classes="field" />
                    </DockPanel>
                    <TextBox Classes="mono" Text="{Binding Value}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88" MaxHeight="260"
                             IsReadOnly="{Binding IsBinary}" Watermark="Paste or generate a value" />
                </StackPanel>

                <!-- Generator -->
                <Border Classes="surface" Padding="12,8" Margin="0,8,0,16" IsVisible="{Binding IsNotLinked}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Classes="subtle" Command="{Binding ReplaceFromFileCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:SymbolIcon Symbol="ArrowUpload" FontSize="16" />
                                <TextBlock Text="From file…" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding GenerateCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:SymbolIcon Symbol="ArrowSync" FontSize="16" />
                                    <TextBlock Text="Generate" />
                                </StackPanel>
                            </Button>
                            <Slider Width="140" Minimum="12" Maximum="64" Value="{Binding GeneratorLength}" IsSnapToTickEnabled="True"
                                    TickFrequency="1" VerticalAlignment="Center" Margin="16,0,8,0" />
                            <TextBlock Text="{Binding GeneratorLength}" VerticalAlignment="Center" Width="24" />
                            <ToggleSwitch IsChecked="{Binding GeneratorSymbols}" OnContent="Symbols" OffContent="Symbols" Margin="12,0,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Text="Notes (optional, up to 255 characters)" Classes="field" />
                <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxLength="255"
                         Watermark="Where it's used, rotation date…" Margin="0,0,0,16" />

                <Expander Header="Icon and colour (defaults to the category's)" Margin="0,0,0,24" HorizontalAlignment="Stretch">
                    <views:IconPicker Icon="{Binding Icon}" Color="{Binding Color}" Margin="0,4,0,0" />
                </Expander>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="accent big" Command="{Binding SaveCommand}" IsEnabled="{Binding !IsBusy}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon Symbol="Save" FontSize="16" />
                            <TextBlock Text="Save" />
                        </StackPanel>
                    </Button>
                    <Button Classes="big" Content="Cancel" Command="{Binding CancelCommand}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
