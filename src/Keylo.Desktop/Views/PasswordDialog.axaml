<views:DialogWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ic="using:FluentIcons.Avalonia"
                    xmlns:views="using:Keylo.Desktop.Views"
                    x:Class="Keylo.Desktop.Views.PasswordDialog"
                    Title="Backup password" Width="460">
    <StackPanel Margin="28,24">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource BrandBrush}">
                <ic:SymbolIcon Symbol="LockClosed" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Name="Heading" FontSize="20" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Name="Message" TextWrapping="Wrap" Margin="0,0,0,18" Foreground="{DynamicResource TextSecondary}" />

        <TextBlock Text="Password" Classes="field" />
        <TextBox Name="First" PasswordChar="•" RevealPassword="False" Margin="0,0,0,12" Classes="revealPasswordButton" />

        <StackPanel Name="ConfirmPanel">
            <TextBlock Text="Confirm password" Classes="field" />
            <TextBox Name="Second" PasswordChar="•" Margin="0,0,0,8" Classes="revealPasswordButton" />
        </StackPanel>

        <TextBlock Name="Problem" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" MinHeight="16" Foreground="{DynamicResource Caution}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0" Spacing="8">
            <Button Classes="big" Content="Cancel" IsCancel="True" Click="OnCancel" />
            <Button Name="OkButton" Classes="accent big" IsDefault="True" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</views:DialogWindow>
