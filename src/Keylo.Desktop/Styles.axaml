<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="using:FluentIcons.Avalonia">

    <!-- ============================================================ text -->
    <Style Selector=":is(TextBlock).section">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SectionText}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector=":is(TextBlock).field">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector=":is(TextBlock).secondary">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector=":is(TextBlock).tertiary">
        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
    </Style>
    <Style Selector=":is(TextBlock).small">
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector=":is(TextBlock).heading">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ============================================================ surfaces -->
    <Style Selector="Border.surface">
        <Setter Property="Background" Value="{DynamicResource CardFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.chip">
        <Setter Property="Background" Value="{DynamicResource ControlFill2}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="9,2" />
    </Style>
    <Style Selector="Border.info">
        <Setter Property="Background" Value="{DynamicResource InfoBg}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="Border.warning">
        <Setter Property="Background" Value="{DynamicResource CautionBg}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,10" />
    </Style>

    <!-- ============================================================ buttons -->
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.big">
        <Setter Property="Padding" Value="18,8" />
    </Style>

    <!-- Icons on accent and danger buttons take the button's text colour. -->
    <Style Selector="Button.accent ic|SymbolIcon">
        <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
    </Style>
    <Style Selector="Button.danger ic|SymbolIcon">
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Borderless, for icon buttons and quiet actions. -->
    <Style Selector="Button.subtle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="Button.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SubtleHover}" />
    </Style>
    <Style Selector="Button.subtle:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SubtlePressed}" />
    </Style>
    <Style Selector="Button.subtle:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="#C42B1C" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#B3261A" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#A3231A" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Top bar icon tiles; the name is in the tooltip. -->
    <Style Selector="Button.tile">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource ControlFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip.ShowDelay" Value="400" />
    </Style>
    <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlFill2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStroke}" />
    </Style>
    <Style Selector="Button.tile.primary">
        <Setter Property="Background" Value="{DynamicResource AccentFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFill}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>
    <Style Selector="Button.tile.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentFill}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Button.tile.quiet">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>

    <!-- ============================================================ lists -->
    <!-- Navigation-style rows: subtle hover/selected fill and an accent pill on the left. -->
    <Style Selector="ListBox.nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.nav > ListBoxItem">
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Name="Bg" CornerRadius="6" Background="Transparent" />
                    <Border Name="Pill" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{DynamicResource AccentFill}" IsVisible="False" />
                    <ContentPresenter Name="PART_ContentPresenter" Margin="{TemplateBinding Padding}"
                                      Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <!-- Fluent's own selection fill sits on the presenter; the Bg border above replaces it. -->
    <Style Selector="ListBox.nav > ListBoxItem /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.nav > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.nav > ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.nav > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.nav > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.nav > ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox.nav > ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="ListBox.nav > ListBoxItem:pointerover /template/ Border#Bg">
        <Setter Property="Background" Value="{DynamicResource SubtleHover}" />
    </Style>
    <Style Selector="ListBox.nav > ListBoxItem:selected /template/ Border#Bg">
        <Setter Property="Background" Value="{DynamicResource SelectedFill}" />
    </Style>
    <Style Selector="ListBox.nav > ListBoxItem:selected /template/ Border#Pill">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- ============================================================ inputs -->
    <Style Selector="TextBox.mono">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    </Style>
    <!-- A read-only value shown like text (selectable). -->
    <Style Selector="TextBox.value">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBox.value:pointerover /template/ Border#PART_BorderElement, TextBox.value:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
</Styles>
