<ui:FluentWindow x:Class="Keylo.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:Keylo.App.ViewModels"
                 xmlns:views="clr-namespace:Keylo.App.Views"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:MainViewModel}"
                 Title="Keylo"
                 Icon="pack://application:,,,/Assets/keylo.ico"
                 Width="1180" Height="760" MinWidth="1080" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 AllowDrop="True">

    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewSecretCommand}" />
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding LockCommand}" />
    </ui:FluentWindow.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Chromeless: no title bar. The top bar (or the lock screen) drags the window; our own buttons sit top-right. -->
        <StackPanel Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="10" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <StackPanel.Resources>
                <Style x:Key="CaptionButton" TargetType="Button">
                    <Setter Property="Width" Value="46" />
                    <Setter Property="Height" Value="34" />
                    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                    <Setter Property="FontSize" Value="10" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#C42B1C" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#A3261A" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </StackPanel.Resources>
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimize" AutomationProperties.Name="Minimize" />
            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" ToolTip="Maximize" AutomationProperties.Name="Maximize" />
            <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="Close" AutomationProperties.Name="Close" />
        </StackPanel>

        <!-- ============================================================ main -->
        <DockPanel Grid.Row="1" Visibility="{Binding IsLocked, Converter={StaticResource HiddenWhen}}">

        <!-- Top bar: brand over the sidebar, search over the list, action tiles over the detail area.
             Its columns follow the sidebar and list widths, so the search box stays above the list. -->
        <Border DockPanel.Dock="Top" Panel.ZIndex="1" Margin="0,0,0,12" Padding="0,12,0,12" MouseLeftButtonDown="OnDragArea"
                Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding Width, ElementName=SidebarColumn}" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="{Binding Width, ElementName=ListColumn}" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.Resources>
                <!-- A labelled icon tile; Tag holds the label. -->
                <Style x:Key="Tile" TargetType="Button">
                    <Setter Property="Width" Value="78" />
                    <Setter Property="Height" Value="58" />
                    <Setter Property="Margin" Value="0,0,8,0" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                    <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" CornerRadius="8" BorderThickness="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                                    <Grid>
                                        <Border x:Name="Shade" CornerRadius="7" Background="Transparent" />
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <ContentPresenter HorizontalAlignment="Center" />
                                            <TextBlock x:Name="Label" Text="{TemplateBinding Tag}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"
                                                       Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <!-- Compact (no room for labels): icon only. -->
                                    <Trigger Property="Tag" Value="">
                                        <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Shade" Property="Background" Value="#14FFFFFF" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Shade" Property="Background" Value="#22000000" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="AccentTile" TargetType="Button" BasedOn="{StaticResource Tile}">
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </Style>
                <Style x:Key="QuietTile" TargetType="Button" BasedOn="{StaticResource Tile}">
                    <Setter Property="Width" Value="62" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                </Style>
            </Grid.Resources>

            <!-- Brand, over the sidebar -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <Image Source="{StaticResource LogoImage}" Width="32" Height="32" />
                <TextBlock Text="Keylo" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </StackPanel>

            <!-- Search, over the list -->
            <ui:TextBox x:Name="SearchBox" Grid.Column="2" Margin="14,0,14,0" VerticalAlignment="Center"
                        PlaceholderText="Search all secrets…   Ctrl+K"
                        Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Action tiles, over the detail area -->
            <DockPanel x:Name="ActionTiles" Grid.Column="4" Margin="14,0,150,0" VerticalAlignment="Center" LastChildFill="False"
                       SizeChanged="OnActionTilesResized">
                <Button DockPanel.Dock="Right" Style="{StaticResource QuietTile}" Tag="Lock" Command="{Binding LockCommand}" Margin="0"
                        ToolTip="Lock (Ctrl+L)" AutomationProperties.Name="Lock">
                    <ui:SymbolIcon Symbol="LockClosed24" FontSize="20" />
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource QuietTile}" Tag="Settings" Command="{Binding OpenSettingsCommand}"
                        ToolTip="Settings" AutomationProperties.Name="Settings">
                    <ui:SymbolIcon Symbol="Settings24" FontSize="20" />
                </Button>
                <Button Style="{StaticResource AccentTile}" Tag="New secret" Command="{Binding NewSecretCommand}"
                        ToolTip="New secret (Ctrl+N)" AutomationProperties.Name="New secret">
                    <ui:SymbolIcon Symbol="Add24" FontSize="20" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Button>
                <Button Style="{StaticResource Tile}" Tag="Import files" Command="{Binding ImportFilesCommand}"
                        ToolTip="Import files as secrets" AutomationProperties.Name="Import files">
                    <ui:SymbolIcon Symbol="DocumentAdd24" FontSize="20" />
                </Button>
                <Button Style="{StaticResource Tile}" Tag="Import folder" Command="{Binding ImportFolderCommand}"
                        ToolTip="Import a folder; subfolders become categories" AutomationProperties.Name="Import folder">
                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="20" />
                </Button>
                <Button Style="{StaticResource Tile}" Tag="Link 1Password" Command="{Binding LinkFromVaultCommand}"
                        ToolTip="Link to a 1Password item (read live, never copied)" AutomationProperties.Name="Link from 1Password">
                    <ui:SymbolIcon Symbol="Link24" FontSize="20" />
                </Button>
            </DockPanel>
        </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="232" MinWidth="180" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="ListColumn" Width="340" MinWidth="240" MaxWidth="720" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- Drag to resize the sidebar and the list; widths are remembered. -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Cursor="SizeWE" Focusable="False" DragCompleted="OnSplitterDragged" />
            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Cursor="SizeWE" Focusable="False" DragCompleted="OnSplitterDragged" />

            <!-- Sidebar: brand, new, categories, footer actions -->
            <DockPanel Grid.Column="0" Margin="12,4,2,12" LastChildFill="True">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="8,0,0,4">
                        <ui:Button DockPanel.Dock="Right" Appearance="Transparent" BorderThickness="0" Padding="6,2" FontSize="12"
                                   Icon="{ui:SymbolIcon Edit16}" Content="Manage" Command="{Binding OpenCategoryManagerCommand}"
                                   ToolTip="Create, rename, merge, delete, and set icons" />
                        <TextBlock Text="CATEGORIES" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" ItemContainerStyle="{StaticResource NavItem}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CategoryItem}">
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <views:IconTile Width="18" Height="18" CornerRadius="4" Image="{Binding Image}"
                                                    Visibility="{Binding HasImage, Converter={StaticResource VisibleWhen}}" />
                                    <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="16" Visibility="{Binding HasImage, Converter={StaticResource HiddenWhen}}">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Foreground" Value="{Binding IconBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IconBrush}" Value="{x:Null}">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="10,0,8,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" CornerRadius="9" Padding="7,1" MinWidth="22"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                        <TextBlock Text="{Binding Count}" FontSize="11" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </DockPanel>

            <!-- Secret list -->
            <Border Grid.Column="2" Margin="0,0,0,0" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                    Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <DockPanel Margin="14,14,14,8">
                    <DockPanel DockPanel.Dock="Top" Margin="4,0,4,6">
                        <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding CountText}" />
                        <TextBlock Text="{Binding ListTitle}" FontWeight="SemiBold" FontSize="14" />
                    </DockPanel>

                    <Grid>
                        <ListBox x:Name="SecretList" ItemsSource="{Binding SecretsView}" SelectedItem="{Binding SelectedSecret}"
                                 SelectionMode="Extended" SelectionChanged="OnSecretSelectionChanged"
                                 ItemContainerStyle="{StaticResource NavItem}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                 VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ToolTip="Ctrl or Shift + click to select several" ToolTipService.InitialShowDelay="2500">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource SectionLabel}" Margin="8,12,0,4" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SecretItemViewModel}">
                                    <Grid Margin="2,2" Background="Transparent"
                                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Command="{Binding PlacementTarget.Tag.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}">
                                                    <MenuItem.Style>
                                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                            <Setter Property="Header" Value="Pin to Home" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                    <Setter Property="Header" Value="Unpin from Home" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </MenuItem.Style>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <views:IconTile Width="36" Height="36" CornerRadius="10" GlyphSize="18"
                                                        Fill="{Binding AvatarBrush}" Image="{Binding Image}" Symbol="{Binding Icon}" Text="{Binding Initial}" />
                                        <DockPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <ui:Button DockPanel.Dock="Right" Appearance="Transparent" BorderThickness="0" Padding="6" Margin="4,0,0,0"
                                                       VerticalAlignment="Center" Icon="{ui:SymbolIcon Pin16}" FontSize="14"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                       ToolTip="Unpin from Home" AutomationProperties.Name="Unpin from Home"
                                                       Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                       CommandParameter="{Binding}"
                                                       Visibility="{Binding IsPinned, Converter={StaticResource VisibleWhen}}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{Binding DisplaySubtitle}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16"
                                    Visibility="{Binding VisibleCount, Converter={StaticResource HiddenWhen}}">
                            <ui:SymbolIcon Symbol="Search24" FontSize="40" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{Binding EmptyTitle}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                            <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" TextAlignment="Center"
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Detail / editor / empty state -->
            <Border Grid.Column="4" BorderThickness="1,1,0,0" Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <!-- Several secrets selected: bulk actions -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420"
                                Visibility="{Binding IsMultiSelect, Converter={StaticResource VisibleWhen}}">
                        <Border Width="64" Height="64" CornerRadius="18" Background="{StaticResource BrandBrush}" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="MultiselectLtr24" FontSize="30" Foreground="White" />
                        </Border>
                        <TextBlock Text="{Binding SelectionText}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,22" />

                        <Border Style="{StaticResource Surface}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="MOVE TO CATEGORY" Style="{StaticResource SectionLabel}" />
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Right" Appearance="Primary" Icon="{ui:SymbolIcon FolderArrowRight24}" Content="Move"
                                               Command="{Binding MoveSelectedCommand}" Margin="8,0,0,0" />
                                    <ComboBox IsEditable="True" ItemsSource="{Binding CategoryNames}"
                                              Text="{Binding BulkCategory, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Pick a category, type a new one, or leave empty for none" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Appearance="Danger" Icon="{ui:SymbolIcon Delete24}" Content="Delete selected"
                                       Command="{Binding DeleteSelectedCommand}" />
                            <ui:Button Appearance="Transparent" Content="Clear selection" Command="{Binding ClearSelectionCommand}" HorizontalAlignment="Left" />
                        </DockPanel>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding ShowEmptyState, Converter={StaticResource VisibleWhen}}">
                        <Image Source="{StaticResource LogoImage}" Width="72" Height="72" Opacity="0.9" HorizontalAlignment="Center" />
                        <TextBlock Text="Select a secret" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,6" />
                        <TextBlock HorizontalAlignment="Center" TextAlignment="Center" FontSize="12" LineHeight="20"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            Values stay encrypted until you reveal or copy them.<LineBreak />
                            Ctrl/Shift + click selects several · Ctrl+A all<LineBreak />
                            Ctrl+N new · Ctrl+F search · Ctrl+L lock
                        </TextBlock>
                    </StackPanel>

                    <views:SecretDetailView DataContext="{Binding Detail}"
                                            Visibility="{Binding DataContext.HasDetail, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}" />
                </Grid>
            </Border>

            <!-- Settings and the category manager take over the list + detail area -->
            <Border Grid.Column="2" Grid.ColumnSpan="3" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Visibility="{Binding IsOverlayOpen, Converter={StaticResource VisibleWhen}}">
                <Grid>
                    <views:SettingsView DataContext="{Binding Settings}"
                                        Visibility="{Binding DataContext.IsSettingsOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}" />
                    <views:CategoryManagerView DataContext="{Binding CategoryManager}"
                                               Visibility="{Binding DataContext.IsCategoryManagerOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}" />
                </Grid>
            </Border>
        </Grid>
        </DockPanel>

        <!-- ============================================================ lock screen -->
        <Grid Grid.Row="1" Background="Transparent" MouseLeftButtonDown="OnDragArea"
              Visibility="{Binding IsLocked, Converter={StaticResource VisibleWhen}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
                <Grid Width="96" Height="96" HorizontalAlignment="Center">
                    <Image Source="{StaticResource LogoImage}">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="48" ShadowDepth="0" Opacity="0.6" Color="#6366F1" />
                        </Image.Effect>
                    </Image>
                    <!-- Lock badge on the corner of the logo. -->
                    <Border Width="34" Height="34" CornerRadius="17" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-8,-8"
                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                        <ui:SymbolIcon Symbol="LockClosed24" FontSize="18" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Border>
                </Grid>
                <TextBlock Text="Keylo is locked" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,26,0,6" />
                <TextBlock Text="Verify with Windows Hello to see your secrets." HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ui:Button Appearance="Primary" HorizontalAlignment="Center" Margin="0,26,0,0" Padding="22,10"
                           Icon="{ui:SymbolIcon Fingerprint24}" Content="Unlock with Windows Hello"
                           Command="{Binding UnlockCommand}" IsEnabled="{Binding IsUnlocking, Converter={StaticResource Not}}" />
                <ui:ProgressRing IsIndeterminate="True" Width="24" Height="24" Margin="0,18,0,0"
                                 Visibility="{Binding IsUnlocking, Converter={StaticResource VisibleWhen}}" />
                <TextBlock Text="{Binding LockMessage}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Grid>

        <ui:SnackbarPresenter x:Name="Snackbar" Grid.Row="1" VerticalAlignment="Bottom" Margin="24" />
    </Grid>
</ui:FluentWindow>
