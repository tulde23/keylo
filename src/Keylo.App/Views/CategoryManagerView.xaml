<UserControl x:Class="Keylo.App.Views.CategoryManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Keylo.App.ViewModels;assembly=Keylo.UI"
             xmlns:views="clr-namespace:Keylo.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CategoryManagerViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24,28,24" FocusVisualStyle="{x:Null}">
        <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">
            <DockPanel Margin="0,0,0,6">
                <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Close"
                           Command="{Binding DataContext.CloseSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Text="Categories" FontSize="26" FontWeight="SemiBold" />
            </DockPanel>
            <TextBlock Margin="0,0,0,22" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Rename a category to rename it on every secret in it; rename onto an existing one to merge. Icons and colours are shown in the sidebar, and on secrets that don't have their own." />

            <!-- ==================================================== new -->
            <TextBlock Text="NEW CATEGORY" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Surface}" Margin="0,0,0,28">
                <StackPanel>
                    <DockPanel>
                        <views:IconTile DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="10" GlyphSize="20" Margin="0,0,12,0"
                                        Fill="{Binding NewTileBrush}" Image="{Binding NewImage}" Symbol="{Binding NewSymbol}" />
                        <ui:Button DockPanel.Dock="Right" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="Create" Command="{Binding CreateCommand}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                        <ui:TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Category name" VerticalAlignment="Center" />
                    </DockPanel>
                    <Expander Header="Icon and colour" Margin="0,12,0,0">
                        <views:IconPicker Icon="{Binding NewIcon}" Color="{Binding NewColor}" Margin="0,10,0,0" />
                    </Expander>
                </StackPanel>
            </Border>

            <!-- ==================================================== existing -->
            <TextBlock Text="YOUR CATEGORIES" Style="{StaticResource SectionLabel}" />
            <TextBlock Text="No categories yet." FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Visibility="{Binding Rows.Count, Converter={StaticResource HiddenWhen}}" />
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CategoryRowViewModel}">
                        <Border Style="{StaticResource Surface}" Margin="0,0,0,10" Padding="14,12">
                            <StackPanel>
                                <DockPanel>
                                    <ui:Button DockPanel.Dock="Left" Appearance="Transparent" Padding="0" Margin="0,0,12,0" BorderThickness="0"
                                               ToolTip="Change icon and colour" Click="OnToggleStyle">
                                        <views:IconTile Width="40" Height="40" CornerRadius="10" GlyphSize="20"
                                                        Fill="{Binding TileBrush}" Image="{Binding Image}" Symbol="{Binding Symbol}" />
                                    </ui:Button>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CountText}" FontSize="12" VerticalAlignment="Center" Margin="12,0,12,0"
                                                   Width="72" TextAlignment="Right"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Save24}" Content="Save" Margin="0,0,6,0"
                                                   Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Delete24}" ToolTip="Delete category"
                                                   Command="{Binding DataContext.AskDeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </DockPanel>

                                <views:IconPicker Icon="{Binding Icon}" Color="{Binding Color}" Margin="52,12,0,0"
                                                  Visibility="{Binding IsEditingStyle, Converter={StaticResource VisibleWhen}}" />

                                <!-- Delete: where do the secrets go? -->
                                <Border CornerRadius="6" Padding="12" Margin="52,12,0,0" Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                                        Visibility="{Binding IsConfirmingDelete, Converter={StaticResource VisibleWhen}}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button Appearance="Secondary" Content="Cancel" Margin="8,0,6,0"
                                                       Command="{Binding DataContext.CancelDeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}" />
                                            <ui:Button Appearance="Danger" Icon="{ui:SymbolIcon Delete24}" Content="Delete category"
                                                       Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock VerticalAlignment="Center" Margin="0,0,10,0">
                                                <Run Text="Move its" /> <Run Text="{Binding CountText, Mode=OneWay}" /> <Run Text="to" />
                                            </TextBlock>
                                            <ComboBox ItemsSource="{Binding DeleteTargets}" SelectedItem="{Binding DeleteTarget}" MinWidth="200" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
