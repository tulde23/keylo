<UserControl x:Class="Keylo.App.Views.IconPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Keylo.App"
             x:Name="Root">
    <StackPanel>
        <!-- Colours -->
        <ListBox x:Name="ColorList" SelectionChanged="OnColorChanged" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Grid Width="30" Height="30" Margin="0,0,6,0" Background="Transparent">
                                    <Ellipse x:Name="Ring" Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="2" Visibility="Hidden" />
                                    <ContentPresenter Margin="4" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Ellipse Fill="{Binding}" ToolTip="{Binding}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Icons -->
        <ListBox x:Name="IconList" SelectionChanged="OnIconChanged" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" MaxHeight="176">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="ToolTip" Value="{Binding}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bg" Width="38" Height="38" Margin="0,0,4,4" CornerRadius="8" Background="Transparent"
                                        BorderThickness="1" BorderBrush="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <ui:SymbolIcon Symbol="{Binding}" FontSize="20" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <ui:Button Appearance="Secondary" Content="Upload image…" Icon="{ui:SymbolIcon ImageAdd24}" Click="OnUpload"
                       Padding="10,5" FontSize="12" ToolTip="PNG, JPG, GIF, BMP, ICO or TIFF. Scaled to fit, never cropped." />
            <Border x:Name="UploadedPreview" Width="30" Height="30" CornerRadius="7" Margin="10,0,0,0" Visibility="Collapsed"
                    RenderOptions.BitmapScalingMode="HighQuality" ToolTip="Uploaded image in use" />
            <ui:Button Appearance="Transparent" Content="Reset to default" Icon="{ui:SymbolIcon ArrowReset24}" Click="OnReset"
                       Margin="8,0,0,0" Padding="8,4" FontSize="12" />
        </StackPanel>
    </StackPanel>
</UserControl>
