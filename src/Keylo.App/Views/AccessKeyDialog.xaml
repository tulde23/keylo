<ui:FluentWindow x:Class="Keylo.App.Views.AccessKeyDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Access key created"
                 Width="600" SizeToContent="Height"
                 ResizeMode="NoResize" ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <StackPanel>
        <ui:TitleBar Title="" ShowMinimize="False" ShowMaximize="False" />
        <StackPanel Margin="28,0,28,24">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource BrandBrush}">
                    <ui:SymbolIcon Symbol="Key24" FontSize="20" Foreground="White" />
                </Border>
                <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <ui:InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Margin="0,0,0,16" Title="Shown only once"
                        Message="Keylo stores only a hash of this key. Add it to Claude Code now; if it's lost, delete the key and create a new one." />

            <TextBlock Text="ACCESS KEY" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
            <Border Style="{StaticResource Surface}" Padding="12,8" Margin="0,0,0,16">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Icon="{ui:SymbolIcon Copy24}" ToolTip="Copy key" Click="OnCopyKey" />
                    <TextBox x:Name="TokenText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" VerticalAlignment="Center"
                             FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </DockPanel>
            </Border>

            <TextBlock Text="REGISTER WITH CLAUDE CODE (USER SCOPE)" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
            <Border Style="{StaticResource Surface}" Padding="12,8" Margin="0,0,0,6">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Icon="{ui:SymbolIcon Copy24}" ToolTip="Copy command" Click="OnCopyCommand" VerticalAlignment="Top" />
                    <TextBox x:Name="CommandText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" TextWrapping="Wrap"
                             FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </DockPanel>
            </Border>
            <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Text="Run it in any terminal, or use the button below. Never put the key in a project's .mcp.json — it would end up in the repository. Copies clear from the clipboard automatically." />

            <TextBlock x:Name="Status" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" MinHeight="16" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <ui:Button x:Name="RegisterButton" Appearance="Primary" Icon="{ui:SymbolIcon PlugConnected24}" Content="Add to Claude Code"
                           Click="OnRegister" Margin="0,0,8,0" Padding="18,8" />
                <ui:Button Appearance="Secondary" Content="Done" IsCancel="True" Click="OnDone" Padding="18,8" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
