<ui:FluentWindow x:Class="Keylo.App.Views.ImportDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:Keylo.App.ViewModels;assembly=Keylo.UI"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:ImportOptionsViewModel}"
                 Title="Import secrets"
                 Width="760" SizeToContent="Height"
                 ResizeMode="NoResize" ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 WindowCornerPreference="Round">

    <StackPanel>
        <ui:TitleBar Title="" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Margin="28,0,28,24">
            <TextBlock Text="Import secrets" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,22" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Run Text="{Binding FileCount, Mode=OneWay}" /><Run Text=" file(s) from " /><Run Text="{Binding Source, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
            </TextBlock>

            <!-- Category -->
            <TextBlock Text="CATEGORY" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Surface}" Margin="0,0,0,16">
                <StackPanel>
                    <RadioButton GroupName="Category" IsChecked="{Binding IsSubfolders}" IsEnabled="{Binding HasSubfolders}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Use subfolder names" />
                            <TextBlock Text="Files in cloud\ go into a 'cloud' category, and so on." FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Category" IsChecked="{Binding IsSingle}" Margin="0,0,0,8">
                        <TextBlock Text="Put everything in one category" />
                    </RadioButton>
                    <ComboBox IsEditable="True" ItemsSource="{Binding Categories}" Margin="28,0,0,12"
                              Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding IsSingle}" ToolTip="Pick an existing category or type a new one" />

                    <RadioButton GroupName="Category" IsChecked="{Binding IsNone}">
                        <TextBlock Text="No category" />
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Overwrite -->
            <Border Style="{StaticResource Surface}" Margin="0,0,0,16">
                <DockPanel>
                    <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Overwrite}" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="Replace secrets that already exist" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="{Binding ConflictCount, Mode=OneWay}" /><Run Text=" of these names are already in Keylo. Off: they're skipped." />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Every file, with an editable name -->
            <DockPanel Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="Names come from the files and types are guessed; change either" VerticalAlignment="Bottom" />
                <TextBlock Text="SECRETS TO CREATE" Style="{StaticResource SectionLabel}" Margin="0" />
            </DockPanel>
            <Border Style="{StaticResource Surface}" Padding="12,8" Margin="0,0,0,22">
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Preview}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ImportRowViewModel}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                                                ToolTip="{Binding FileName}" ClearButtonEnabled="False" />
                                    <ComboBox Grid.Column="3" Width="150" Margin="8,0,0,0" VerticalAlignment="Center"
                                              ItemsSource="{Binding TypeChoices}" SelectedItem="{Binding Type}" ToolTip="Type (guessed from the file)">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:TypeChoice}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Border Grid.Column="1" CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                            Visibility="{Binding HasProblem, Converter={StaticResource VisibleWhen}}">
                                        <TextBlock Text="{Binding Problem}" FontSize="11" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                    </Border>
                                    <Border Grid.Column="2" CornerRadius="10" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                        <TextBlock Text="{Binding Category}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <DockPanel>
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="Original files are left untouched." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Appearance="Secondary" Content="Cancel" IsCancel="True" Click="OnCancel" Margin="0,0,8,0" Padding="18,8" />
                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}" Content="Import" IsDefault="True" Click="OnImport"
                               IsEnabled="{Binding CanImport}" Padding="18,8" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
