<ui:FluentWindow x:Class="Keylo.App.Views.PasswordDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Backup password"
                 Width="460" SizeToContent="Height"
                 ResizeMode="NoResize" ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 WindowCornerPreference="Round">
    <StackPanel>
        <ui:TitleBar Title="" ShowMinimize="False" ShowMaximize="False" />
        <StackPanel Margin="28,0,28,24">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource BrandBrush}">
                    <ui:SymbolIcon Symbol="LockClosed24" FontSize="20" Foreground="White" />
                </Border>
                <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,0,0,18" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
            <ui:PasswordBox x:Name="First" Margin="0,0,0,12" PasswordChanged="OnPasswordChanged" />

            <StackPanel x:Name="ConfirmPanel">
                <TextBlock Text="Confirm password" Style="{StaticResource FieldLabel}" />
                <ui:PasswordBox x:Name="Second" Margin="0,0,0,8" PasswordChanged="OnPasswordChanged" />
            </StackPanel>

            <TextBlock x:Name="Problem" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" MinHeight="16"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <ui:Button Appearance="Secondary" Content="Cancel" IsCancel="True" Click="OnCancel" Margin="0,0,8,0" Padding="18,8" />
                <ui:Button x:Name="OkButton" Appearance="Primary" IsDefault="True" Click="OnOk" Padding="18,8" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
