<UserControl x:Class="Keylo.App.Views.SecretDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Keylo.App.ViewModels"
             xmlns:views="clr-namespace:Keylo.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SecretDetailViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24,28,24" FocusVisualStyle="{x:Null}">
        <StackPanel MaxWidth="720" HorizontalAlignment="Stretch">

            <!-- ======================================================== view mode -->
            <StackPanel Visibility="{Binding IsViewing, Converter={StaticResource VisibleWhen}}">
                <DockPanel Margin="0,0,0,24">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon Edit24}" Content="Edit" Command="{Binding EditCommand}" Margin="0,0,8,0" />
                        <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon Delete24}" ToolTip="Delete" Command="{Binding DeleteCommand}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <views:IconTile Width="56" Height="56" CornerRadius="16" GlyphSize="28"
                                        Fill="{Binding TileBrush}" Image="{Binding Image}" Symbol="{Binding Symbol}" />
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border CornerRadius="10" Padding="9,2" Margin="0,0,6,0"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        Visibility="{Binding IsTyped, Converter={StaticResource VisibleWhen}}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="{Binding SelectedType.Symbol}" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding TypeName}" FontSize="12" Margin="5,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="10" Padding="9,2"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        Visibility="{Binding HasCategory, Converter={StaticResource VisibleWhen}}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Folder16" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding Category}" FontSize="12" Margin="5,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <!-- Typed fields -->
                <StackPanel Visibility="{Binding IsTyped, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,4">
                    <DockPanel Margin="2,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ui:Button Appearance="Transparent" Command="{Binding ToggleValueCommand}" ToolTip="Show / hide secret fields (hides itself after 30s)">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Icon" Value="{ui:SymbolIcon Eye24}" />
                                        <Setter Property="Content" Value="Show" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsValueVisible}" Value="True">
                                                <Setter Property="Icon" Value="{ui:SymbolIcon EyeOff24}" />
                                                <Setter Property="Content" Value="Hide" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Copy24}" Content="Copy main value" Command="{Binding CopyValueCommand}" Margin="6,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="FIELDS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Fields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FieldViewModel}">
                                <Border Style="{StaticResource Surface}" Margin="0,0,0,8" Padding="16,10"
                                        Visibility="{Binding ShowInView, Converter={StaticResource VisibleWhen}}">
                                    <DockPanel>
                                        <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Icon="{ui:SymbolIcon Copy24}" VerticalAlignment="Center"
                                                   ToolTip="Copy" Command="{Binding CopyCommand}" Margin="12,0,0,0" />
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SectionLabel}" Style="{StaticResource SectionLabel}" Margin="0,0,0,2" />
                                                <TextBlock Text="  · built from the fields above" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           Visibility="{Binding IsDerived, Converter={StaticResource VisibleWhen}}" />
                                            </StackPanel>
                                            <TextBox Text="{Binding DisplayValue, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                                     TextWrapping="Wrap" MaxHeight="200" VerticalScrollBarVisibility="Auto" FontSize="14"
                                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSecret}" Value="True">
                                                                <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Value (plain secrets) -->
                <Border Style="{StaticResource Surface}" Margin="0,0,0,12" Visibility="{Binding IsPlain, Converter={StaticResource VisibleWhen}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <ui:Button Appearance="Transparent" Command="{Binding ToggleValueCommand}" ToolTip="Show / hide (hides itself after 30s)">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Icon" Value="{ui:SymbolIcon Eye24}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsValueVisible}" Value="True">
                                                <Setter Property="Icon" Value="{ui:SymbolIcon EyeOff24}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Copy24}" Content="Copy" Command="{Binding CopyValueCommand}" Margin="6,0,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="VALUE" Style="{StaticResource SectionLabel}" />
                            <TextBox Text="{Binding MaskedValue, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                                     FontFamily="{StaticResource MonoFont}" FontSize="15" TextWrapping="Wrap" MaxHeight="220"
                                     VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Key (stored as the credential's username) -->
                <Border Style="{StaticResource Surface}" Margin="0,0,0,12" Visibility="{Binding ShowKey, Converter={StaticResource VisibleWhen}}">
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Icon="{ui:SymbolIcon Copy24}" ToolTip="Copy key"
                                   Command="{Binding CopyUsernameCommand}" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="KEY" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding Username}" FontSize="15" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Notes -->
                <Border Style="{StaticResource Surface}" Margin="0,0,0,12" Visibility="{Binding HasNotes, Converter={StaticResource VisibleWhen}}">
                    <StackPanel>
                        <TextBlock Text="NOTES" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Details -->
                <Border Style="{StaticResource Surface}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="UPDATED" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding UpdatedText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="SIZE" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding SizeText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="STORED IN" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding StorageText}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Push to other vaults + export -->
                <TextBlock Text="SHARE" Style="{StaticResource SectionLabel}" Margin="2,12,0,8" />
                <WrapPanel>
                    <ItemsControl ItemsSource="{Binding Providers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProviderItem}">
                                <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon CloudArrowUp24}" Margin="0,0,8,8"
                                           Content="{Binding PushLabel}"
                                           Command="{Binding DataContext.PushToCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon ArrowExportUp24}" Content="Export to file…"
                               Command="{Binding ExportCommand}" Margin="0,0,8,8" />
                    <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon WindowConsole20}" Content="Copy CLI command"
                               Command="{Binding CopyGetCommandCommand}" Margin="0,0,8,8"
                               ToolTip="Copies the 'keylo get' command that prints this secret's key and value — paste it to Claude Code. The command itself contains no secret." />
                </WrapPanel>
            </StackPanel>

            <!-- ======================================================== edit / new -->
            <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource VisibleWhen}}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                    <views:IconTile Width="44" Height="44" CornerRadius="12" GlyphSize="22"
                                    Fill="{Binding TileBrush}" Image="{Binding Image}" Symbol="{Binding Symbol}" />
                    <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock Text="Type" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding TypeChoices}" SelectedItem="{Binding SelectedType}" Margin="0,0,0,16" HorizontalAlignment="Left" MinWidth="260">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TypeChoice}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                        <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. cloudflare-token" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Category" Style="{StaticResource FieldLabel}" />
                        <ComboBox IsEditable="True" ItemsSource="{Binding Categories}" Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <!-- Typed: one editor per field -->
                <ItemsControl ItemsSource="{Binding Fields}" Visibility="{Binding IsTyped, Converter={StaticResource VisibleWhen}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FieldViewModel}">
                            <StackPanel Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource FieldLabel}" />
                                    <ui:SymbolIcon Symbol="LockClosed16" FontSize="12" Margin="6,0,0,4" ToolTip="Secret: encrypted, masked, redacted from agent output"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Visibility="{Binding IsSecret, Converter={StaticResource VisibleWhen}}" />
                                </StackPanel>
                                <ComboBox IsEditable="True" ItemsSource="{Binding Options}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                          Visibility="{Binding HasOptions, Converter={StaticResource VisibleWhen}}" />
                                <ui:TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding Placeholder}"
                                            Visibility="{Binding HasOptions, Converter={StaticResource HiddenWhen}}"
                                            TextWrapping="Wrap" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <ui:TextBox.Style>
                                        <Style TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSecret}" Value="True">
                                                    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsMultiline}" Value="True">
                                                    <Setter Property="AcceptsReturn" Value="True" />
                                                    <Setter Property="MinHeight" Value="88" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:TextBox.Style>
                                </ui:TextBox>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Plain: key and value -->
                <StackPanel Visibility="{Binding IsPlain, Converter={StaticResource VisibleWhen}}">
                <TextBlock Text="Key (optional)" Style="{StaticResource FieldLabel}" />
                <ui:TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Key id, account or email" Margin="0,0,0,16" />

                <DockPanel Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="{Binding ValueLength, StringFormat='{}{0} characters'}" />
                    <TextBlock Text="Value" Style="{StaticResource FieldLabel}" />
                </DockPanel>
                <ui:TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                            MinHeight="88" MaxHeight="260" VerticalScrollBarVisibility="Auto"
                            FontFamily="{StaticResource MonoFont}" IsReadOnly="{Binding IsBinary}" PlaceholderText="Paste or generate a value" />
                </StackPanel>

                <!-- Generator -->
                <Border Style="{StaticResource Surface}" Padding="12,8" Margin="0,8,0,16">
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Icon="{ui:SymbolIcon ArrowUpload24}" Content="From file…"
                                   Command="{Binding ReplaceFromFileCommand}" />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Appearance="Secondary" Icon="{ui:SymbolIcon ArrowSync24}" Content="Generate" Command="{Binding GenerateCommand}" />
                            <Slider Width="140" Minimum="12" Maximum="64" Value="{Binding GeneratorLength}" IsSnapToTickEnabled="True"
                                    TickFrequency="1" VerticalAlignment="Center" Margin="16,0,8,0" />
                            <TextBlock Text="{Binding GeneratorLength}" VerticalAlignment="Center" Width="24" />
                            <ui:ToggleSwitch IsChecked="{Binding GeneratorSymbols}" Content="Symbols" Margin="12,0,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Text="Notes (optional, up to 255 characters)" Style="{StaticResource FieldLabel}" />
                <ui:TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                            MinHeight="64" MaxLength="255" PlaceholderText="Where it's used, rotation date…" Margin="0,0,0,16" />

                <Expander Header="Icon and colour (defaults to the category's)" Margin="0,0,0,24">
                    <views:IconPicker Icon="{Binding Icon}" Color="{Binding Color}" Margin="0,10,0,0" />
                </Expander>

                <StackPanel Orientation="Horizontal">
                    <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Content="Save" Command="{Binding SaveCommand}"
                               IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" Padding="18,8" />
                    <ui:Button Appearance="Secondary" Content="Cancel" Command="{Binding CancelCommand}" Margin="8,0,0,0" Padding="18,8" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
